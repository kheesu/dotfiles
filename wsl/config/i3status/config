# i3status — minimal bar for a WSL dev box.
# No battery/wifi/temp modules: WSL has no real hardware to report, so they'd
# show errors or garbage. Just what's meaningful inside the VM.

general {
    colors = true
    interval = 5
    color_good     = "#A6E3A1"
    color_degraded = "#F9E2AF"
    color_bad      = "#F38BA8"
}

order += "cpu_usage"
order += "load"
order += "memory"
order += "disk /"
order += "tztime local"

cpu_usage {
    format = " %usage"
}

load {
    format = "load %1min"
}

memory {
    format = " %used / %total"
    threshold_degraded = "1G"
    format_degraded = " LOW %available"
}

disk "/" {
    format = " %avail"
}

tztime local {
    format = " %Y-%m-%d  %H:%M"
}
