# ==============================================================================
#  i3 config — WSL Arch dev environment (accessed over xrdp)
#  Keyboard-centric, minimal. Mod = Super. No compositor (software-rendered
#  under xrdp, so effects would only add lag).
# ==============================================================================

set $mod Mod4

# JetBrains Mono Nerd Font for titlebars/bar
font pango:JetBrainsMono Nerd Font 10

# ------------------------------------------------------------------------------
# Applications
# ------------------------------------------------------------------------------
# xterm is used deliberately: GPU-accelerated terminals are sluggish over
# xrdp's software GL. Launch a login shell so PATH/starship/etc. load.
bindsym $mod+Return exec xterm -e "tmux new-session -A -s main"
bindsym $mod+Shift+Return exec xterm

# dmenu — tiny, no GPU, fits the minimal goal.
bindsym $mod+space exec --no-startup-id dmenu_run -fn "JetBrainsMono Nerd Font-10" -nb "#1E1E2E" -nf "#CDD6F4" -sb "#B4BEFE" -sf "#1E1E2E"

# ------------------------------------------------------------------------------
# Window control
# ------------------------------------------------------------------------------
bindsym $mod+w      kill
bindsym $mod+f      fullscreen toggle
bindsym $mod+v      floating toggle
bindsym $mod+Shift+r restart
bindsym $mod+Shift+m exit

# Split orientation (i3's linear tiling — like the root Hyprland/Sway setups)
bindsym $mod+backslash split h
bindsym $mod+minus     split v

# Layout modes
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split

# ------------------------------------------------------------------------------
# Focus & move (vim hjkl) — mirrors the deck/root configs
# ------------------------------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ------------------------------------------------------------------------------
# Resize
# ------------------------------------------------------------------------------
bindsym $mod+Mod1+h resize shrink width  5 px or 5 ppt
bindsym $mod+Mod1+l resize grow   width  5 px or 5 ppt
bindsym $mod+Mod1+k resize shrink height 5 px or 5 ppt
bindsym $mod+Mod1+j resize grow   height 5 px or 5 ppt

# ------------------------------------------------------------------------------
# Workspaces (1–10)
# ------------------------------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Cycle workspaces (matches the Super+Ctrl+h/l muscle memory from deck/root)
bindsym $mod+Ctrl+h workspace prev
bindsym $mod+Ctrl+l workspace next

# ------------------------------------------------------------------------------
# Gaps (subtle — i3-gaps is merged into i3 since 4.22)
# ------------------------------------------------------------------------------
gaps inner 6
gaps outer 2
smart_gaps on
smart_borders on
default_border pixel 2

# ------------------------------------------------------------------------------
# Colours — Catppuccin Mocha (matches kitty/rofi themes elsewhere in repo)
# ------------------------------------------------------------------------------
#                       border   backgr   text     indicator child_border
client.focused          #B4BEFE  #B4BEFE  #1E1E2E  #F5E0DC   #B4BEFE
client.focused_inactive #45475A  #45475A  #CDD6F4  #45475A   #45475A
client.unfocused        #1E1E2E  #1E1E2E  #6C7086  #1E1E2E   #1E1E2E
client.urgent           #F38BA8  #F38BA8  #1E1E2E  #F38BA8   #F38BA8

# ------------------------------------------------------------------------------
# Status bar
# ------------------------------------------------------------------------------
bar {
    status_command i3status
    position top
    tray_output none
    colors {
        background #1E1E2E
        statusline #CDD6F4
        separator  #6C7086
        #                  border   backgr   text
        focused_workspace  #B4BEFE  #B4BEFE  #1E1E2E
        active_workspace   #45475A  #45475A  #CDD6F4
        inactive_workspace #1E1E2E  #1E1E2E  #6C7086
        urgent_workspace   #F38BA8  #F38BA8  #1E1E2E
    }
}

# ------------------------------------------------------------------------------
# Autostart
# ------------------------------------------------------------------------------
# Korean/Japanese input. Env vars are exported in ~/.xsession before i3 starts.
exec --no-startup-id fcitx5 -d
